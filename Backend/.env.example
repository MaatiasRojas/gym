# Copiá este archivo como ".env" y completá los valores.
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Conexión a Neon CON pooling (el host tiene "-pooler"). La usa la app.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Conexión a Neon SIN pooling (el mismo host sin "-pooler"). La usan las migraciones de Prisma.
DIRECT_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Clave para firmar las sesiones: cualquier texto largo y secreto.
# Generá una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambiás, todos tienen que volver a iniciar sesión.
JWT_SECRET=

# Opcionales
# PORT=3001
# SESION_DIAS=30
